---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

// FormspreeのフォームIDは、HTMLの送信先に使う公開識別子です。
// 受信メールアドレスや認証情報はサイト内に保存しません。
const formId = 'xpparkqn';
const formAction = `https://formspree.io/f/${formId}`;
---
<BaseLayout
  title="お問い合わせ"
  description="「それ、家を決める前に。」へのお問い合わせページです。記事内容、広告・掲載、サイトに関するお問い合わせを受け付けています。"
  noindex
>
  <Breadcrumbs items={[{ label: 'お問い合わせ' }]} />

  <section class="page-hero shell">
    <p class="eyebrow">CONTACT</p>
    <h1>お問い合わせ</h1>
    <p>当サイトへのお問い合わせは、下記フォームよりお願いいたします。電話によるお問い合わせは受け付けておりません。内容を確認のうえ、必要に応じてメールで返信いたします。</p>
  </section>

  <section class="contact-page shell">
    <aside class="contact-notice" aria-labelledby="contact-notice-title">
      <h2 id="contact-notice-title">お問い合わせ前にご確認ください</h2>
      <ul>
        <li>電話でのお問い合わせは受け付けていません。</li>
        <li>すべてのお問い合わせへの返信を保証するものではありません。</li>
        <li>営業・勧誘等の内容については返信しない場合があります。</li>
        <li>記事内容に誤りの指摘がある場合は、該当記事のURLもご記載ください。</li>
        <li>フォームに入力された個人情報は、お問い合わせへの対応以外の目的では使用しません。</li>
      </ul>
    </aside>

    <div id="contact-success" class="form-message form-success" role="status" aria-live="polite" tabindex="-1" hidden>
      <h2>送信が完了しました</h2>
      <p>お問い合わせを受け付けました。内容を確認のうえ、必要に応じてメールでご連絡いたします。</p>
    </div>

    <div id="contact-error" class="form-message form-error" role="alert" tabindex="-1" hidden>
      <p>送信できませんでした。時間をおいて、もう一度お試しください。</p>
    </div>

    <form
      id="contact-form"
      class="contact-form"
      action={formAction}
      method="post"
      accept-charset="UTF-8"
      data-configured="true"
    >
      <div class="form-field">
        <label for="contact-name">お名前またはニックネーム <span class="optional-label">任意</span></label>
        <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" />
      </div>

      <div class="form-field">
        <label for="contact-email">メールアドレス <span class="required-label">必須</span></label>
        <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
      </div>

      <div class="form-field">
        <label for="contact-type">お問い合わせ種別 <span class="required-label">必須</span></label>
        <select id="contact-type" name="inquiry_type" required>
          <option value="">選択してください</option>
          <option value="記事内容について">記事内容について</option>
          <option value="広告・掲載について">広告・掲載について</option>
          <option value="サイトについて">サイトについて</option>
          <option value="その他">その他</option>
        </select>
      </div>

      <div class="form-field">
        <label for="contact-subject">件名 <span class="required-label">必須</span></label>
        <input id="contact-subject" name="subject" type="text" maxlength="200" required />
      </div>

      <div class="form-field">
        <label for="contact-message">お問い合わせ内容 <span class="required-label">必須</span></label>
        <textarea id="contact-message" name="message" rows="10" maxlength="5000" aria-describedby="message-help" required></textarea>
        <p id="message-help" class="field-help">記事内容に関するご指摘の場合は、該当記事のURLもご記載ください。</p>
      </div>

      <div class="honeypot" aria-hidden="true">
        <label for="contact-company">会社名</label>
        <input id="contact-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="agreement-field">
        <input id="contact-agreement" name="privacy_agreement" type="checkbox" value="同意する" required />
        <label for="contact-agreement"><a href="/privacy" target="_blank" rel="noopener noreferrer">個人情報の取り扱い</a>に同意する <span class="required-label">必須</span></label>
      </div>

      <button id="contact-submit" class="contact-submit" type="submit">
        <span class="submit-label">送信する</span>
        <span class="submitting-label" hidden>送信中…</span>
      </button>

    </form>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
    const submitLabel = submitButton?.querySelector<HTMLElement>('.submit-label');
    const submittingLabel = submitButton?.querySelector<HTMLElement>('.submitting-label');
    const successMessage = document.querySelector<HTMLElement>('#contact-success');
    const errorMessage = document.querySelector<HTMLElement>('#contact-error');
    let isSubmitting = false;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (isSubmitting || form.dataset.configured !== 'true' || !form.action) return;
      if (!form.reportValidity()) return;

      isSubmitting = true;
      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.hidden = true;
      if (submittingLabel) submittingLabel.hidden = false;
      if (errorMessage) errorMessage.hidden = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Submission failed');

        form.reset();
        form.hidden = true;
        if (successMessage) {
          successMessage.hidden = false;
          successMessage.focus();
        }
      } catch {
        isSubmitting = false;
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.hidden = false;
        if (submittingLabel) submittingLabel.hidden = true;
        if (errorMessage) {
          errorMessage.hidden = false;
          errorMessage.focus();
        }
      }
    });
  </script>
</BaseLayout>
