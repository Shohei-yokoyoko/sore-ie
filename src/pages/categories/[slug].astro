---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories } from '../../site-config';

export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category.slug)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const customHomeStages = [
  { title: '家づくりを考え始めた', description: '家の選び方や、注文住宅を検討する最初の段階です。', ids: ['built-house-vs-custom-home', 'custom-home-building-flow', 'housing-exhibition-before-visit'] },
  { title: '住宅会社を選ぶ', description: '比較する基準・会社数・価格の見方を整理します。', ids: ['housemaker-vs-builder', 'housing-company-checkpoints', 'how-many-house-builders', 'house-builder-price-per-tsubo'] },
  { title: '見積もり・契約を確認する', description: '具体的な見積書や契約前の確認へ進んだ段階です。', ids: ['house-builder-estimate-comparison', 'custom-home-before-contract-checklist'] },
  { title: '予算・後悔を防ぐ', description: '予算と、住んでから気づきやすい点を確認します。', ids: ['custom-home-budget-overrun', 'home-building-regrets', 'custom-home-floor-plan-regrets'] },
  { title: '住宅会社・相談サービスを比較する', description: '住宅会社や相談方法の候補を集めたい段階です。', ids: ['custom-home-request-service-comparison'] },
].map((stage) => ({ ...stage, posts: stage.ids.flatMap((id) => { const post = posts.find((item) => item.id === id); return post ? [post] : []; }) }));
---
<BaseLayout title={category.name} description={category.short}>
  <Breadcrumbs items={[{ label: 'カテゴリー', href: '/categories' }, { label: category.name }]} />
  <section class="page-hero shell"><p class="eyebrow">CATEGORY</p><h1>{category.name}</h1><p>{category.short}</p></section>
  <section class="section shell">
    {category.slug === 'custom-home' && posts.length ? <>
      <div class="section-heading"><p class="eyebrow">PURPOSE GUIDE</p><h2>今の悩みから探す</h2><p>家づくりの検討段階に合わせて、必要な記事から確認できます。</p></div>
      <div class="stage-groups">{customHomeStages.map((stage) => stage.posts.length > 0 && <section class="stage-section"><div class="stage-heading"><h2>{stage.title}</h2><p>{stage.description}</p></div><div class="post-list">{stage.posts.map((post) => <article><p>{post.data.publishedAt.toLocaleDateString('ja-JP')}</p><h3><a href={`/articles/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div></section>)}</div>
      <section class="category-post-index" aria-labelledby="published-posts-heading"><div class="section-heading"><p class="eyebrow">ALL ARTICLES</p><h2 id="published-posts-heading">公開記事一覧</h2><p>注文住宅・家づくりの記事を公開日順に確認できます。</p></div><div class="post-list">{posts.map((post) => <article><p>{post.data.publishedAt.toLocaleDateString('ja-JP')}</p><h3><a href={`/articles/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div></section>
    </> : posts.length ? <div class="post-list">{posts.map((post) => <article><p>{post.data.publishedAt.toLocaleDateString('ja-JP')}</p><h2><a href={`/articles/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}</div> : <div class="empty-state"><strong>このカテゴリーの記事は準備中です。</strong><p>本文と事実確認が完了した記事だけを公開します。</p><a class="text-link" href="/categories">ほかのカテゴリーを見る →</a></div>}
  </section>
</BaseLayout>

