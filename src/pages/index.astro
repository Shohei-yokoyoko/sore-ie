---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { categories, siteConfig } from '../site-config';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const countFor = (slug: string) => posts.filter((post) => post.data.category === slug).length;
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">借りる・買う・建てる。その前に。</p>
        <h1>家の迷いを、<br /><span>決める前にほどく。</span></h1>
        <p class="hero-lead">{siteConfig.concept}</p>
        <a class="text-link" href="#start">今の悩みから探す <span aria-hidden="true">↓</span></a>
      </div>
      <div class="home-visual" role="img" aria-label="緑と木の温もりを感じる家のイラスト">
        <div class="sun"></div><div class="hill back"></div><div class="hill front"></div>
        <div class="house"><span class="roof"></span><span class="window one"></span><span class="window two"></span><span class="door"></span></div>
        <div class="tree t1"></div><div class="tree t2"></div>
        <p>迷いに近い入口から。</p>
      </div>
    </div>
  </section>

  <section class="section shell" id="start">
    <div class="section-heading"><p class="eyebrow">初めての方へ</p><h2>いまの状況から、読む場所を選ぶ</h2><p>目的が決まっていなくても大丈夫。近い悩みから始められます。</p></div>
    <div class="path-grid">
      <a href="/categories/buy-or-rent"><small>住まい方</small><strong>買うか、借りるか迷っている</strong><span>住まい方を考える →</span></a>
      <a href="/articles/housing-exhibition-before-visit"><small>家づくり</small><strong>注文住宅を考え始めた</strong><span>住宅展示場へ行く前に確認する →</span></a>
      <a href="/categories/moving"><small>新生活</small><strong>引越しを控えている</strong><span>新生活を整える →</span></a>
    </div>
  </section>

  <section class="section soft-section">
    <div class="shell">
      <div class="section-heading split"><div><p class="eyebrow">FIND YOUR QUESTION</p><h2>今、どこで迷っていますか？</h2></div><p>家づくりは、全員が同じ順番で悩むわけではありません。今の状況に近いところから確認してください。</p></div>
      <div class="decision-grid">
        <a href="/articles/custom-home-building-flow"><strong>何から始めればいいか分からない</strong><p>家づくり全体の流れや、最初に考えることを整理したい人向け。</p><span>注文住宅を建てるまでの流れを確認する →</span></a>
        <a href="/articles/built-house-vs-custom-home"><strong>建売住宅と注文住宅で迷っている</strong><p>建売と注文住宅の違いを比較し、自分に合う方を考えたい人向け。</p><span>建売と注文住宅の違いを比較する →</span></a>
        <a href="/articles/housing-exhibition-before-visit"><strong>住宅展示場へ行こうか迷っている</strong><p>展示場へ行く前に準備しておきたいことを確認したい人向け。</p><span>住宅展示場へ行く前の準備を確認する →</span></a>
        <a href="/articles/housing-company-checkpoints"><strong>住宅会社をどう選べばいいか分からない</strong><p>ハウスメーカー・工務店を選ぶときの判断基準を整理したい人向け。</p><span>住宅会社選びのチェックポイントを見る →</span></a>
        <a href="/articles/how-many-house-builders"><strong>何社くらい比較すればいいか知りたい</strong><p>住宅会社を何社比較するべきか迷っている人向け。</p><span>ハウスメーカーの比較社数を確認する →</span></a>
        <a href="/articles/custom-home-request-service-comparison"><strong>比較する住宅会社がまだ十分にない</strong><p>これから住宅会社や提案を比較したい人向け。</p><span>住宅会社・資料請求サービスを比較する →</span></a>
        <a href="/articles/house-builder-estimate-comparison"><strong>見積書を比較したい</strong><p>複数社の見積もりや総額、費用項目を比較したい人向け。</p><span>ハウスメーカーの見積書を比較する →</span></a>
        <a href="/articles/custom-home-before-contract-checklist"><strong>契約前の最終確認をしたい</strong><p>契約直前に確認漏れがないかチェックしたい人向け。</p><span>注文住宅の契約前チェック項目を見る →</span></a>
      </div>
      {posts.length === 0 && <p class="empty-note">現在、公開中の記事はありません。未完成の記事は表示していません。</p>}
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><p class="eyebrow">CATEGORIES</p><h2>住まいのテーマから探す</h2></div>
    <div class="category-grid">{categories.map((category) => <CategoryCard category={category} count={countFor(category.slug)} />)}</div>
  </section>

  <section class="section about-strip">
    <div class="shell about-grid"><div><p class="eyebrow">ABOUT THIS BLOG</p><h2>知りたいことを、決める前に。</h2></div><div><p>住まいに詳しくない方にも伝わる言葉で、判断に必要な情報を一つずつ整理するブログです。</p><a class="text-link" href="/about">このブログについて →</a></div></div>
  </section>
</BaseLayout>
