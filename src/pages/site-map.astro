---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import { categories } from '../site-config';
---
<BaseLayout title="サイトマップ"><Breadcrumbs items={[{ label: 'サイトマップ' }]} /><section class="page-hero shell"><p class="eyebrow">SITE MAP</p><h1>サイトマップ</h1></section><section class="legal-page shell"><h2>カテゴリー</h2><ul>{categories.map((item) => <li><a href={`/categories/${item.slug}`}>{item.name}</a></li>)}</ul><h2>このサイトについて</h2><ul><li><a href="/about">このブログについて</a></li><li><a href="/profile">プロフィール</a></li><li><a href="/privacy">プライバシーポリシー</a></li><li><a href="/disclaimer">免責事項</a></li><li><a href="/contact">お問い合わせ</a></li></ul></section></BaseLayout>
